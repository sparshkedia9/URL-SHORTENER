# Copy this file to .env and fill in your own values. Never commit .env.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/url_shortener

# The address short links are built with (e.g. http://localhost:8000/q0U)
BASE_URL=http://localhost:8000

# Secret key required to delete links (send it in the X-Admin-Key header).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change_me
